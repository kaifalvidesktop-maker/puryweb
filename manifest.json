{
  "manifest_version": 3,
  "name": "PuryWeb",
  "short_name": "PuryWeb",
  "version": "0.7.0",
  "description": "PuryWeb — AI Internet Purifier. Make any website clean, focused and trustworthy.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "PuryWeb — Purify this page"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "os/os.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Purify this page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "shared/*.js",
        "content/*.js",
        "templates/*.js",
        "prompts/*.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}